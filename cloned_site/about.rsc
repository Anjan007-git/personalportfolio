15:T8f9,{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://tanishbhavsar.vercel.app/#person","name":"Tanish Bhavsar","givenName":"Tanish","familyName":"Bhavsar","alternateName":["Tanish","Tanish-Dev"],"url":"https://tanishbhavsar.vercel.app","image":"https://tanishbhavsar.vercel.app/tanish-bhavsar.jpg","email":"mailto:tanishbhavsar2007@gmail.com","jobTitle":"AI engineer and full-stack developer","description":"Tanish Bhavsar is an AI engineer and full-stack developer in Pune, India, who ships real products: AI systems, agents and the web apps around them. Open to freelance work and internships.","address":{"@type":"PostalAddress","addressLocality":"Pune","addressRegion":"Maharashtra","addressCountry":"IN"},"hasOccupation":{"@type":"Occupation","name":"AI engineer","occupationLocation":{"@type":"Country","name":"India"},"skills":"AI Engineering, Agentic Systems, Full-Stack Web, UI/UX, Hardware & IoT"},"knowsAbout":["AI Engineering","Agentic Systems","Full-Stack Web","UI/UX","Hardware & IoT","Artificial intelligence","Machine learning","Large language models","Web development","Claude","Figma","Framer","GitHub","Docker","Webflow","JavaScript","Photoshop","Python","C++","React","Next.js","FastAPI","Node.js","TensorFlow","OpenCV","Gemini","LangChain","Firebase","MongoDB","Blender","Raspberry Pi","ElevenLabs","TypeScript","PyTorch","PostgreSQL","Arduino"],"alumniOf":{"@type":"CollegeOrUniversity","name":"MIT World Peace University"},"award":["Top 100 — Google Solution Challenge 2026"],"sameAs":["https://github.com/Tanish-Dev","https://www.linkedin.com/in/tanish-bhavsar-a96354286","https://x.com/tanish_bhavsar","https://leetcode.com/u/Tanish_dev"],"mainEntityOfPage":{"@id":"https://tanishbhavsar.vercel.app/about#webpage"}},{"@type":"WebSite","@id":"https://tanishbhavsar.vercel.app/#website","url":"https://tanishbhavsar.vercel.app","name":"Tanish Bhavsar","alternateName":"Tanish Bhavsar — portfolio","description":"Tanish Bhavsar is an AI engineer and full-stack developer in Pune, India, who ships real products: AI systems, agents and the web apps around them. Open to freelance work and internships.","inLanguage":"en-IN","publisher":{"@id":"https://tanishbhavsar.vercel.app/#person"},"author":{"@id":"https://tanishbhavsar.vercel.app/#person"}}]}8:["$","$L14",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}],["$","$L16",null,{"skills":["UI/UX","3D design","AI Engineering","Agentic Systems","Full-Stack Web","Hardware & IoT","Claude","Figma","Docker","JavaScript","Python","C++","React","Next.js","FastAPI","Node.js","TensorFlow","OpenCV","Gemini","LangChain","Blender","Raspberry Pi","TypeScript","PyTorch","PostgreSQL"]}],["$","$L17",null,{"children":["$","$L18",null,{"email":"tanishbhavsar2007@gmail.com","socials":[{"label":"GitHub","url":"https://github.com/Tanish-Dev"},{"label":"LinkedIn","url":"https://www.linkedin.com/in/tanish-bhavsar-a96354286"},{"label":"X","url":"https://x.com/tanish_bhavsar"},{"label":"LeetCode","url":"https://leetcode.com/u/Tanish_dev"}],"resumeUrl":"/tanish-bhavsar-cv.pdf","children":[["$","$L19",null,{}],["$","$L1a",null,{}],["$","$L1b",null,{"availability":{"text":"Open to freelance and internships","open":true},"links":[{"href":"/","label":"Home"},{"href":"/work","label":"Work"},{"href":"/about","label":"About"},{"href":"/contact","label":"Contact"}],"email":"tanishbhavsar2007@gmail.com","socials":"$8:props:children:2:props:children:props:socials","workPreview":{"media":{"url":"/mockups-projects/new/ChatGPT%20Image%2011%20Oct%202026%2C%2018_35_02.png","width":1536,"height":1024,"alt":"The Emergency Core operations dashboard, with incident counts, two active alerts and their AI situation briefs","kind":"image"},"title":"Rapid Crisis Response","accent":"#E8363C"}}],"$L1c","$L1d"]}]}]]}]
1e:Te23,{"@context":"https://schema.org","@graph":[{"@type":"ProfilePage","@id":"https://tanishbhavsar.vercel.app/about#webpage","url":"https://tanishbhavsar.vercel.app/about","name":"About Tanish Bhavsar — AI engineer and full-stack developer","description":"Who Tanish Bhavsar is: an AI engineer and full-stack developer in Pune, India. Background, education, experience, skills and how to work with him.","inLanguage":"en-IN","isPartOf":{"@id":"https://tanishbhavsar.vercel.app/#website"},"about":{"@id":"https://tanishbhavsar.vercel.app/#person"},"mainEntity":{"@id":"https://tanishbhavsar.vercel.app/#person"},"dateModified":"2026-10-12"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://tanishbhavsar.vercel.app"},{"@type":"ListItem","position":2,"name":"About","item":"https://tanishbhavsar.vercel.app/about"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Who is Tanish Bhavsar?","acceptedAnswer":{"@type":"Answer","text":"I'm Tanish Bhavsar, an AI engineer and full-stack developer based in Pune, India. I build AI systems and the interfaces around them, from the model to the last pixel. I'm studying for a B.Tech in Computer Science (AI and Data Science) at MIT World Peace University, Pune."}},{"@type":"Question","name":"What kind of work do you take on?","acceptedAnswer":{"@type":"Answer","text":"AI Engineering: Models, pipelines and evaluation, taken from a notebook to a service that holds up in production. Agentic Systems: Tool-using agents with guardrails, memory and clear failure modes, built on Gemini and Claude. Full-Stack Web: Next.js, TypeScript and Postgres. Fast pages, typed APIs and deploys that don't need babysitting. UI/UX: Interfaces designed in Figma and shipped in code, with the details intact. Hardware & IoT: Raspberry Pi and Arduino builds that put voice, sensing and AI into the physical world."}},{"@type":"Question","name":"Which technologies do you work with?","acceptedAnswer":{"@type":"Answer","text":"Claude, Figma, Framer, GitHub, Docker, Webflow, JavaScript, Photoshop, Python, C++, React, Next.js, FastAPI, Node.js, TensorFlow, OpenCV, Gemini, LangChain, Firebase, MongoDB, Blender, Raspberry Pi, ElevenLabs, TypeScript, PyTorch, PostgreSQL and Arduino. I pick the tool that fits the problem, and I'd rather go deep on a few than skim a hundred."}},{"@type":"Question","name":"What have you built?","acceptedAnswer":{"@type":"Answer","text":"Rapid Crisis Response was selected as a Top 100 project in the Google Solution Challenge 2026. AI emergency coordination for hospitality venues, from panic button to staff brief. Live work includes CredZen, Ignisia '26, Ajinkya Jadhav Photography and FIFA World Cup 2026 Dashboard. There are 10 case studies on the work page, each with the problem, the approach and the stack."}},{"@type":"Question","name":"What experience do you have?","acceptedAnswer":{"@type":"Answer","text":"Freelance developer, Nov 2024 – present. Web applications for clients, with API integrations and custom features: turning requirements into working software, designed and built end to end. AI intern at Stark Digital Media Services, Jun – Aug 2025. Built AI solutions including chatbots, hospital assistants, document verification and automation tools, using Python, FastAPI, LangChain, OCR, YOLO and Docker."}},{"@type":"Question","name":"Are you available for freelance work or internships?","acceptedAnswer":{"@type":"Answer","text":"Yes. Open to freelance and internships. Email tanishbhavsar2007@gmail.com or use the contact form; I usually reply within a day."}}]}]}9:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}],"$L1f","$L20","$L21","$L22"]
